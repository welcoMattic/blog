---
import { getCollection, render } from 'astro:content';
import { isPublished } from '../../lib/publish';
import Article from '../../layouts/Article.astro';
import SeriesNav from '../../components/SeriesNav.astro';
import { excerpt } from '../../lib/utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', isPublished);
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = entry.data.description ?? excerpt(entry.body);
---

<Article
  section="blog"
  title={entry.data.title}
  description={description}
  date={entry.data.date}
  tags={entry.data.tags}
  lang={entry.data.lang}
  noindex={entry.data.noindex}
  origin={entry.data.origin}
  body={entry.body}
  ogImage={`/og/blog/${entry.id}.png`}
>
  {
    entry.data.series && (
      <SeriesNav name={entry.data.series.name} lang={entry.data.lang} currentId={entry.id} />
    )
  }
  <Content />
</Article>
