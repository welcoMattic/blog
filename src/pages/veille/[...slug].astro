---
import { getCollection, render } from 'astro:content';
import Article from '../../layouts/Article.astro';
import { veilleDescription } from '../../lib/utils';

export async function getStaticPaths() {
  const issues = await getCollection('veille');
  return issues.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const description = veilleDescription(entry.body, entry.data.date);
---

<Article
  section="veille"
  title={entry.data.title}
  description={description}
  date={entry.data.date}
  tags={entry.data.tags}
  body={entry.body}
  ogImage={`/og/veille/${entry.id}.png`}
>
  <Content />
</Article>
