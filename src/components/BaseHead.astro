---
interface Props {
  title?: string;
  description: string;
  canonicalURL?: string;
  noindex?: boolean;
  lang?: 'fr' | 'en';
  ogImage?: string;
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
}

const {
  title,
  description,
  canonicalURL,
  noindex = false,
  lang = 'fr',
  ogImage,
  article,
} = Astro.props;

const SITE_NAME = 'welcomattic';
const PERSON_ID = 'https://blog.welcomattic.com/#person';

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const canonical = canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImageURL = new URL(ogImage ?? '/og/default.png', Astro.site).href;
const ogLocale = lang === 'fr' ? 'fr_FR' : 'en_US';

const person = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: 'Mathieu Santostefano',
  alternateName: 'welcomattic',
  url: 'https://blog.welcomattic.com/',
  sameAs: [
    'https://github.com/welcomattic',
    'https://www.linkedin.com/in/msantostefano/',
    'https://phpc.social/@welcomattic',
    'https://bsky.app/profile/welcomattic.com',
    'https://symfony.com/contributors/welcomattic',
  ],
};

const graph: object[] = [person];

if (article) {
  graph.push({
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: article.publishedTime.toISOString(),
    dateModified: (article.modifiedTime ?? article.publishedTime).toISOString(),
    inLanguage: lang,
    keywords: article.tags?.join(', '),
    author: { '@id': PERSON_ID },
    mainEntityOfPage: canonical,
    image: ogImageURL,
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="Mathieu Santostefano" />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={canonical} />

<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{article && <meta property="article:published_time" content={article.publishedTime.toISOString()} />}
{article?.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL} />

<link rel="icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#9c3328" />
<meta name="theme-color" content="#2e2e33" />

<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/index.xml" />
<link rel="me" href="https://phpc.social/@welcomattic" />

<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.coolify.kloude.fr/js/pa-03uHMb4NO0e5Kw03MQdKg.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
