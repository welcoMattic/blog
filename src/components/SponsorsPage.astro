---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { frenchPunctuation } from '../lib/utils';
import {
  CONTACT_EMAIL,
  CONTACT_LINKEDIN,
  SPONSORS_URL,
  SPONSORS_PAGE,
  tiers,
  tierUrl,
  logoSponsors,
  otherSponsors,
  pastSponsors,
  type Lang,
  type Tier,
} from '../data/sponsors';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const other: Lang = lang === 'en' ? 'fr' : 'en';

// Une page par langue plutôt qu'une page traduite par le bouton FR/EN : le
// bouton ne réécrit que les libellés de l'interface, côté client, et vaut
// français par défaut. Le CTA d'un article anglais doit mener à une page
// anglaise, et chaque langue doit être indexée.
//
// Tout le texte vit dans content/sponsors/<lang>.md : la prose dans le corps
// Markdown, le reste (titre, chapeau, libellés, texte de chaque palier) dans le
// front matter. Ce composant n'est que le gabarit.
const page = await getEntry('sponsors', lang);
if (!page) throw new Error(`content/sponsors/${lang}.md est introuvable.`);
const t = page.data;

// La ligne `<!-- paliers -->` du Markdown marque l'endroit où la grille des
// paliers s'insère dans le texte. Sans marqueur, elle suit tout le texte.
const [beforeTiers, afterTiers = ''] = (page.rendered?.html ?? '').split('<!-- paliers -->');

const perk = (tier: Tier) => {
  const key = `${tier.amount}/${tier.frequency}`;
  const text = t.tiers.perks[key];
  if (!text) throw new Error(`content/sponsors/${lang}.md : pas de texte pour le palier « ${key} » (tiers.perks).`);
  return text;
};

const heading = (text: string) => frenchPunctuation(text, lang);

// « $100 » en anglais, « 100 $ » en français, l'espace insécable évitant que le
// symbole parte seul à la ligne.
const price = (amount: number) => (lang === 'en' ? `$${amount}` : `${amount}\u00a0$`);

// Grille de 12 colonnes : dans un groupe, les paliers mis en avant et les
// autres forment chacun leur ligne et s'en partagent la largeur. Avec la grille
// actuelle, cela donne 4 petits paliers mensuels puis les 3 paliers entreprise,
// et les 3 ponctuels puis le bridge à 750 $ en pleine largeur. Une ligne qui
// déborde passe à la suivante sans rien casser, simplement moins proprement.
const spans = (items: Tier[]) => {
  const featured = items.filter((tier) => tier.featured).length;
  const regular = items.length - featured;
  return (tier: Tier) => Math.max(3, Math.floor(12 / (tier.featured ? featured : regular)));
};

const groups = [
  { title: t.tiers.monthly, frequency: 'monthly', suffix: t.tiers.perMonth },
  { title: t.tiers.oneTime, frequency: 'one-time', suffix: t.tiers.once },
].map(({ title, frequency, suffix }) => {
  // Les paliers mis en avant (entreprise, bridge) passent en tête de leur groupe.
  const all = tiers.filter((tier) => tier.frequency === frequency);
  const items = [...all.filter((tier) => tier.featured), ...all.filter((tier) => !tier.featured)];
  return { title, suffix, items, span: spans(items) };
});

const alternates = [
  { hreflang: 'en', href: SPONSORS_PAGE.en },
  { hreflang: 'fr', href: SPONSORS_PAGE.fr },
  { hreflang: 'x-default', href: SPONSORS_PAGE.en },
];
---

<Base title={t.title} description={t.description} lang={lang} alternates={alternates}>
  <div class="sponsors">
    <header>
      <p class="twin meta">
        <a href={SPONSORS_PAGE[other]} hreflang={other} lang={other}>{t.twin}</a>
      </p>
      <h1>{heading(t.title)}</h1>
      <p class="lede">{t.lede}</p>
      <p><a class="button" href={SPONSORS_URL}>{t.button}</a></p>
    </header>

    <div class="prose" set:html={beforeTiers} />

    <section>
      <h2>{heading(t.tiers.title)}</h2>
      {
        groups.map(({ title, items, suffix, span }) => (
          <>
            <h3 class="eyebrow">{title}</h3>
            <ul class="tiers">
              {items.map((tier) => (
                <li class:list={['tier', { 'tier--featured': tier.featured }]} style={`--span: ${span(tier)}`}>
                  <p class="tier-price">
                    <strong>{price(tier.amount)}</strong> <span>{suffix}</span>
                  </p>
                  {tier.name && <p class="tier-name">{tier.name}</p>}
                  <p class="tier-perk">{perk(tier)}</p>
                  {tier.contact && (
                    <p class="tier-contact">
                      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a> · <a href={CONTACT_LINKEDIN}>LinkedIn</a>
                    </p>
                  )}
                  <a class="tier-link" href={tierUrl(tier)}>
                    {t.tiers.choose}
                  </a>
                </li>
              ))}
            </ul>
          </>
        ))
      }
      <p class="meta">{t.tiers.note}</p>
    </section>

    {afterTiers && <div class="prose" set:html={afterTiers} />}

    <section>
      <h2>{heading(t.sponsors.title)}</h2>
      {
        logoSponsors.length > 0 && (
          <ul class="sponsor-logos">
            {logoSponsors.map((sponsor) => (
              <li>
                <a href={sponsor.url} rel="sponsored">
                  <img src={`/img/sponsors/${sponsor.logo}`} alt={sponsor.name} loading="lazy" />
                </a>
              </li>
            ))}
          </ul>
        )
      }
      {
        otherSponsors.length > 0 && (
          <p class="sponsor-names">
            {t.sponsors.alsoBy}{' '}
            {otherSponsors.map((sponsor, index) => (
              <>
                {index > 0 && ', '}
                <a href={sponsor.url} rel="sponsored">
                  {sponsor.name}
                </a>
              </>
            ))}
          </p>
        )
      }
      {logoSponsors.length + otherSponsors.length === 0 && <p>{t.sponsors.empty}</p>}
      {
        pastSponsors.length > 0 && (
          <>
            <h3 class="eyebrow">{t.sponsors.past}</h3>
            <ul class="past-sponsors">
              {pastSponsors.map((sponsor) => (
                <li>
                  <a href={sponsor.url} rel="sponsored">
                    {sponsor.name}
                  </a>
                  {t.sponsors.pastNotes[sponsor.name] && <>, {t.sponsors.pastNotes[sponsor.name]}</>}
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="meta">{t.sponsors.note}</p>
    </section>
  </div>
</Base>

<style>
  .twin {
    margin: 0 0 0.5rem;
  }

  .twin a {
    color: var(--muted);
  }

  .twin a:hover {
    color: var(--accent);
  }

  h1 {
    margin-top: 0;
  }

  .lede {
    font-size: 1.2rem;
    color: var(--muted);
    max-width: 44rem;
  }

  .button {
    display: inline-block;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--paper);
    background: var(--accent);
    border-radius: 6px;
    padding: 0.55rem 1.1rem;
  }

  .button:hover {
    color: var(--paper);
    background: var(--accent-dark);
    text-decoration: none;
  }

  /* `.prose` est centrée et bornée à 48rem pour les articles : ici, les blocs de
     texte s'alignent à gauche sur l'en-tête et la grille des paliers. */
  .prose {
    margin: 0;
  }

  h2,
  .prose :global(h2) {
    margin-top: 2.75rem;
  }

  h3.eyebrow {
    font-size: 0.72rem;
    margin: 1.75rem 0 0.75rem;
  }

  .tiers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1rem;
  }

  .tier {
    grid-column: span var(--span);
  }

  /* Trop étroit pour quatre cartes de front : deux par ligne, et une seule sur
     un téléphone. */
  @media (max-width: 52rem) {
    .tier {
      grid-column: span 6;
    }
  }

  @media (max-width: 34rem) {
    .tier {
      grid-column: 1 / -1;
    }
  }

  .tier {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--hairline);
    border-radius: 6px;
    padding: 1rem 1.1rem;
    background: var(--paper-soft);
  }

  .tier--featured {
    border-top: 3px solid var(--accent);
  }

  .tier p {
    margin: 0;
  }

  .tier-price strong {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 600;
  }

  .tier-price span,
  .tier-name {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }

  .tier-name {
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .tier .tier-perk {
    margin: 0.6rem 0 1rem;
    font-size: 0.95rem;
    line-height: 1.5;
    flex-grow: 1;
  }

  .tier .tier-contact {
    margin: -0.4rem 0 1rem;
    font-size: 0.9rem;
  }

  .tier-link {
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* Les logos des sponsors sont posés sur une tuile claire dans les deux
     thèmes : un logo sombre sur fond transparent disparaîtrait en mode sombre.
     Tuile de taille fixe, image contenue dedans : pas de décalage de mise en
     page au chargement, quelles que soient les proportions du logo. */
  .sponsor-logos {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .sponsor-logos a {
    display: block;
    width: 12rem;
    height: 5rem;
    padding: 0.75rem 1rem;
    background: #fff;
    border: 1px solid var(--hairline);
    border-radius: 6px;
  }

  .sponsor-logos img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .sponsor-names {
    color: var(--muted);
  }

  .past-sponsors {
    margin: 0 0 1.25rem;
    padding-left: 1.2em;
    color: var(--muted);
  }
</style>
