---
import { getCollection } from 'astro:content';
import { isPublished } from '../lib/publish';
import { frenchPunctuation } from '../lib/utils';

interface Props {
  name: string;
  lang: 'fr' | 'en';
  currentId: string;
}

const { name, lang, currentId } = Astro.props;

// Le filtre de publication programmée s'applique aussi ici : un article encore
// à venir n'apparaît pas dans le sommaire, donc le sommaire ne peut pas pointer
// vers une page qui n'existe pas encore dans le build. Un article partagé en
// avance n'apparaît que dans son propre sommaire, jamais dans celui des autres.
const entries = (await getCollection('blog', (entry) => isPublished(entry) || entry.id === currentId))
  .filter((entry) => entry.data.series?.name === name && entry.data.lang === lang)
  .sort((a, b) => a.data.series!.order - b.data.series!.order);

const heading = lang === 'en' ? 'In this series' : 'Dans cette série';
---

{
  entries.length > 1 && (
    <nav class="series" aria-label={heading}>
      <p class="series-heading">{heading}</p>
      <ol>
        {entries.map((entry) => (
          <li aria-current={entry.id === currentId ? 'page' : undefined}>
            {entry.id === currentId ? (
              <span>{frenchPunctuation(entry.data.series!.label, lang)}</span>
            ) : (
              <a href={`/blog/${entry.id}/`}>{frenchPunctuation(entry.data.series!.label, lang)}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  /* Le sommaire vit en tête de la colonne latérale de l'article. Il y prend la
     mise en forme de la colonne (sans, corps réduit, pas de cadre) plutôt que la
     carte encadrée qu'il était en tête du contenu : posée contre le sommaire de
     l'article, une deuxième carte accentuée ferait lourd. */
  .series {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .series-heading {
    margin: 0 0 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .series ol {
    margin: 0;
    padding-left: 1.3em;
  }

  .series li {
    margin: 0.3rem 0;
    color: var(--muted);
  }

  .series li[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
</style>
