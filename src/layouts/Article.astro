---
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import ArticleRail from '../components/ArticleRail.astro';
import SlideViewer from '../components/SlideViewer.astro';
import { formatDate, readingMinutes, slugifyTag, langFlag, sectionLabel, frenchPunctuation } from '../lib/utils';

interface Props {
  section: 'blog' | 'veille' | 'talks';
  title: string;
  description: string;
  date: Date;
  tags?: string[];
  lang?: 'fr' | 'en';
  noindex?: boolean;
  origin?: { url: string; site: string };
  body?: string;
  ogImage: string;
  pdf?: string;
  headings?: MarkdownHeading[];
}

const {
  section,
  title,
  description,
  date,
  tags = [],
  lang = 'fr',
  noindex = false,
  origin,
  body,
  ogImage,
  pdf,
  headings = [],
} = Astro.props;

// La durée de lecture et la mention d'origine décrivent l'article lui-même :
// elles suivent sa langue, pas celle que le visiteur a choisie pour l'interface
// avec le bouton FR/EN. D'où l'absence de `data-i18n` sur ces deux éléments,
// que le switcher de Header.astro réécrirait sinon. Même règle, même raison
// pour les libellés de la colonne latérale (voir ArticleRail.astro).
const minutes = readingMinutes(body);
const readingLabel = lang === 'en' ? `${minutes} min read` : `${minutes} min de lecture`;
const originLabel = lang === 'en' ? 'Originally published on' : 'Publié à l’origine sur';
---

<Base
  title={title}
  description={description}
  lang={lang}
  noindex={noindex}
  ogImage={ogImage}
  article={{ publishedTime: date, tags }}
  wide
>
  <!-- L'<aside> est posé entre l'en-tête et le corps, pas après : c'est l'ordre
       qu'on veut en colonne unique (titre, sommaire, texte) et au clavier, et la
       grille de global.css le renvoie à droite dès qu'il y a la place. -->
  <article class="prose article-layout">
    <header>
      <a class="eyebrow" href={`/${section}/`}>{sectionLabel(section)}</a>
      <h1>{frenchPunctuation(title, lang)}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        {' · '}
        <span>{readingLabel}</span>
        {' '}
        <span class="flag" title={lang === 'en' ? 'English' : 'Français'}>{langFlag(lang)}</span>
      </p>
      {
        origin && (
          <p class="attribution-banner">
            <span>{originLabel}</span>
            {' '}
            <a href={origin.url}>{origin.site}</a>.
          </p>
        )
      }
    </header>

    <ArticleRail headings={headings} date={date} tags={tags} lang={lang} minutes={minutes} body={body}>
      <slot name="rail" />
    </ArticleRail>

    <div class="article-body">
      {pdf && <SlideViewer src={pdf} title={title} />}

      <slot />

      {
        tags.length > 0 && (
          <footer class="tags">
            {tags.map((tag) => (
              <a class="pill" href={`/tags/${slugifyTag(tag)}/`}>
                #{tag}
              </a>
            ))}
          </footer>
        )
      }
    </div>
  </article>
</Base>

<style>
  h1 {
    margin-top: 0.35rem;
    margin-bottom: 0.35rem;
  }

  .tags {
    margin-top: 2.25rem;
  }
</style>
