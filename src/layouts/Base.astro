---
import '../styles/global.css';
import { Font } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description: string;
  canonicalURL?: string;
  noindex?: boolean;
  lang?: 'fr' | 'en';
  ogImage?: string;
  article?: { publishedTime: Date; modifiedTime?: Date; tags?: string[] };
  alternates?: { hreflang: string; href: string }[];
  wide?: boolean;
}

// `wide` élargit la carte pour les pages qui posent une colonne latérale à côté
// du texte, c'est-à-dire les articles. Les autres gardent la largeur d'origine :
// une carte plus large autour d'une colonne unique n'ajouterait que du vide.
// Le drapeau est sorti du reste des props, que BaseHead reçoit en bloc.
const { lang = 'fr', wide = false, ...head } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead lang={lang} {...head} />
    <Font cssVariable="--font-serif" preload />
    <Font cssVariable="--font-sans" preload />
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') {
          document.documentElement.dataset.theme = saved;
        }

        // La langue de l'interface décide quels contenus sont grisés dans les
        // listes. Posée ici, avant le premier rendu, pour éviter que les
        // entrées apparaissent à pleine opacité le temps d'un éclair.
        document.documentElement.dataset.uiLang =
          localStorage.getItem('ui-lang') === 'en' ? 'en' : 'fr';
      })();
    </script>
  </head>
  <body>
    <div class:list={['frame', { 'frame--wide': wide }]}>
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
